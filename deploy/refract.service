[Unit]
Description=refract SFU
Documentation=https://github.com/refract-labs/refract
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/refract --config /etc/refract/refract.toml
Restart=on-failure
RestartSec=1s
RestartSteps=8
RestartMaxDelaySec=60s
LimitNOFILE=1048576
LimitMEMLOCK=infinity
CPUAffinity=0-63
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/refract /var/lib/refract /var/log/refract
RuntimeDirectory=refract
RuntimeDirectoryMode=0750
StateDirectory=refract
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
